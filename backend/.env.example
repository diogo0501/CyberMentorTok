APP_NAME=CyberMentorTok
APP_VERSION=1.0.0
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybermentortok
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VIDEOS=cybermentortok-videos
S3_BUCKET_BACKGROUNDS=cybermentortok-backgrounds
S3_BUCKET_ASSETS=cybermentortok-assets

OPENSEARCH_URL=http://localhost:9200
CLICKHOUSE_URL=http://localhost:8123

RENDERING_WORKERS=4
RENDER_TIMEOUT_SECONDS=300

AI_FACT_CHECK_CONFIDENCE_THRESHOLD=0.95

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
